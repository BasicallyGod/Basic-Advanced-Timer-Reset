<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bat.Reset.HostComparison</AssemblyName><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="../../.tools/core-source/src/Timer.Core/Timer.Core.csproj" />
    <Compile Include="../native-notes/NoteStore.cs" Link="NoteStore.cs" />
    <Content Include="../native-notes/Editor/**" Link="Editor/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../prototypes/vendor/toastui-editor-3.2.2.min.js" Link="Editor/vendor/editor.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../prototypes/vendor/LICENSE-toastui-editor.txt" Link="Editor/vendor/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../prototypes/src/editor-rules.js" Link="Editor/editor-rules.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludeUnusedWebViewWpfAdapter" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
